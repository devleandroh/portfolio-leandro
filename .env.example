# =====================================================================
# Copie este arquivo para .env.local e preencha com os valores do SEU
# novo projeto Supabase. Nunca coloque valores reais neste arquivo.
# =====================================================================

# --- Banco de dados (Supabase) ---------------------------------------
# Project Settings → API (ou "Connect") no painel do Supabase.
# Sem estas duas variáveis, as demos usam o gerador sintético local.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...).
# NUNCA use a chave service_role / secret aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: force "synthetic" para ignorar o banco mesmo se configurado.
DATA_SOURCE=

# --- Site ---------------------------------------------------------------
# URL pública do site (usada em metadados / Open Graph).
NEXT_PUBLIC_SITE_URL=

# --- Perfil e contato (links vazios são ocultados) ----------------------
NEXT_PUBLIC_PROFILE_NAME=
NEXT_PUBLIC_PROFILE_LOCATION=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_FREELAS_URL=
NEXT_PUBLIC_WHATSAPP_URL=
